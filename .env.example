# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (Dashboard → Project Settings → API). Nunca versione o .env.local.

# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# SOMENTE a chave publicável (sb_publishable_...). Ela é pública por desenho:
# quem protege os dados são as permissões no banco.
# NUNCA coloque aqui a chave secreta (sb_secret_...) nem a service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Subpasta do site publicado (ex.: /dominacao-chocolatosa). Vazio em local.
NEXT_PUBLIC_BASE_PATH=
